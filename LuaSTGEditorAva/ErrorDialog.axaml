<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LuaSTGEditorAva.ErrorDialog"
        Title="LuaSTG Editor Ava"
        Width="520" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <DockPanel Margin="12">
    <Button DockPanel.Dock="Bottom" Name="OkButton" Content="OK"
            HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="90" />
    <ScrollViewer>
      <TextBlock Name="MessageText" TextWrapping="Wrap" />
    </ScrollViewer>
  </DockPanel>
</Window>
