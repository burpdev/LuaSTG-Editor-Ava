<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LuaSTGEditorAva.Input.PathWindow"
        Title="Choose file"
        Width="520" Height="150"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Name="BrowseBtn" Content="Browse..." MinWidth="90" />
      <Button Name="OkBtn" Content="OK" MinWidth="90" />
      <Button Name="CancelBtn" Content="Cancel" MinWidth="90" />
    </StackPanel>
    <TextBox Name="PathBox" />
  </DockPanel>
</Window>
